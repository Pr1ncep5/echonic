{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "nextjs",
    "jsx-a11y",
    "import",
    "eslint",
    "promise",
    "vitest",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["src/components/ui/**", ".next/**", "out/**", "build/**", "next-env.d.ts"],
  "rules": {},
  "overrides": [
    {
      "files": ["src/instrumentation-client.ts"],
      "rules": { "import/namespace": "off" }
    },
    {
      "files": ["e2e/**/*.spec.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@playwright/test",
                "message": "Import test and expect from ./support/test: its fixtures give each journey its own Organization."
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
