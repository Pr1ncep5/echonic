    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
