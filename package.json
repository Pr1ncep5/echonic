{
  "name": "echonic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "types": "next typegen && tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run lint && bun run types && bun run fmt:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "docker compose -f compose.test.yaml up -d --wait",
    "test:db:stop": "docker compose -f compose.test.yaml down",
    "e2e": "playwright test",
    "e2e:serve": "bun e2e/serve.ts",
    "db:seed": "bun run scripts/seed-system-voices.ts",
    "sync-api": "bun run scripts/sync-api.ts",
    "clean": "rm -rf .next node_modules && bun install",
    "bump-nextjs": "bunx @next/codemod@canary upgrade latest",
    "doctor": "bunx react-doctor@latest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
