    "@trpc/tanstack-react-query": "^11.28.2",
    "@types/recordrtc": "^5.6.15",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
